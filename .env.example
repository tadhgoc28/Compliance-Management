# Supabase
# Project Settings -> API in the Supabase dashboard.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Server-side only. Bypasses row level security - never expose to the browser
# and never prefix it with NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Optional. Basemap style for MapLibre. Defaults to a free OpenStreetMap raster
# style that needs no key. Swap for Mapbox/Ordnance Survey when you have one.
NEXT_PUBLIC_MAP_STYLE_URL=

# Email notifications via Resend
# Get API key from https://resend.com
RESEND_API_KEY=
RESEND_FROM_EMAIL=noreply@complyra.io

# Application URL (used in email links)
NEXT_PUBLIC_APP_URL=http://localhost:3000
